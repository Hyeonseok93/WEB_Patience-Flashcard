# DB
POSTGRES_DB=patience
POSTGRES_USER=patience
POSTGRES_PASSWORD=patience-local-change-me
DB_HOST=db
DB_PORT=5432

# JWT (최소 32자). 공개 서비스: SPRING_PROFILES_ACTIVE=prod + 고유 시크릿.
JWT_SECRET=patience-local-jwt-secret-change-me-32b

# 쿠키. 공개 HTTPS면 true.
JWT_COOKIE_SECURE=false

# 로컬 메일 (Mailhog UI: http://localhost:8025)
SPRING_MAIL_HOST=mailhog
SPRING_MAIL_PORT=1025
APP_MAIL_FROM=Patience <patience@localhost>
# 공개 서비스: Mailhog 대신 실제 SMTP
# SPRING_MAIL_HOST=smtp.resend.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=resend
# SPRING_MAIL_PASSWORD=re_xxxxxxxx
# APP_MAIL_FROM=Patience <noreply@your-domain>

# 공개 서비스: 인증 링크를 다시 쓸 때
# APP_PUBLIC_BASE_URL=https://your-domain

# 로컬은 비워 둠. 공개 서비스:
# SPRING_PROFILES_ACTIVE=prod

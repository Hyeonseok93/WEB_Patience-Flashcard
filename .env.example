# DB
POSTGRES_DB=patience
POSTGRES_USER=patience
POSTGRES_PASSWORD=patience-local-change-me
DB_HOST=db
DB_PORT=5432

# JWT (min 32 chars). For real deploy set SPRING_PROFILES_ACTIVE=prod and a unique secret.
